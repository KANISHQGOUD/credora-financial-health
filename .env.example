# Copy to .env and replace every "change-this" value.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_DB=credora
POSTGRES_USER=credora
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://credora:change-this-local-password@db:5432/credora

# Must be at least 32 bytes; the API refuses to start otherwise.
JWT_SECRET_KEY=change-this-to-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of sites allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Where the frontend finds the API (baked in at build time for production).
VITE_API_URL=http://localhost:8000/api/v1

# Shared read-only demo accounts and their "Try a demo" buttons.
DEMO_MODE=true
# Interactive API docs at /docs. Set to false for public deployments.
DOCS_ENABLED=true
# Sign-up / sign-in / demo requests allowed per client IP. Generous, because a
# class or office shares one public IP.
AUTH_RATE_LIMIT=30/minute
# Sign-in attempts allowed per client IP and email address together
# (stops password guessing on one account).
LOGIN_ACCOUNT_RATE_LIMIT=5/minute
